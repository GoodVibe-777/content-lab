# Copy this file to .env locally. Never commit real API keys.
GEMINI_API_KEY=
GROQ_API_KEY=

# Model defaults can be changed without editing source code.
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=llama-3.3-70b-versatile

APP_NAME=Content Lab API
APP_ENV=development
APP_DATA_DIR=./data
PIXABAY_API_KEY=
